# Gemini
GEMINI_API_KEY=your_gemini_api_key

# Gmail SMTP
GMAIL_ADDRESS=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password

# Qdrant Cloud (Local dev or remote)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# MongoDB
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/vaultmail?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your_super_secret_key_here

# App (CORS)
# Set this to your Vercel URL in production (e.g. https://your-app.vercel.app)
FRONTEND_URL=http://localhost:5173
